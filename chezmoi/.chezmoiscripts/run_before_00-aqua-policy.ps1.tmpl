{{ if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = 'Stop'

# The 00- target name reserves the first before-script slot for this guard.
$repoRoot = Split-Path -Parent '{{ .chezmoi.sourceDir }}'
$aquaPolicy = Join-Path $repoRoot 'aqua-policy.yaml'
# The reviewed digest is written by hand in .aqua-policy.sha256, shared with CI and
# tests: deriving it from the policy would approve policy changes without a review.
# A file, unlike chezmoi data, cannot be overridden by a local configuration, and a
# malformed file renders an empty digest that never matches.
$expectedPolicySha256 = '{{ include ".aqua-policy.sha256" | regexFind "^[0-9a-f]{64}" }}'
$actualPolicySha256 = (Get-FileHash -LiteralPath $aquaPolicy -Algorithm SHA256).Hash
if ($actualPolicySha256 -ne $expectedPolicySha256) {
    throw 'aqua-policy.yaml does not match the reviewed SHA-256. Review the policy and local registry before updating the pinned digest in chezmoi/.aqua-policy.sha256.'
}

$aqua = (Get-Command aqua -ErrorAction Stop).Source
& $aqua policy allow $aquaPolicy
if ($LASTEXITCODE -ne 0) {
    throw "aqua policy allow failed (exit code: $LASTEXITCODE)"
}
{{- end }}
