{{- /* chezmoi:modify-template */ -}}
{{- /*

~/.claude/settings.json のうち、plugin の取得元と有効・無効だけを .dotfiles の
管理下に置く。Claude Code 自身が同じファイルへ permissions や hooks を書き込む
ため、ファイル全体を置き換えるとそれらを巻き戻してしまう。modify_ テンプレート
は現在の内容を .chezmoi.stdin で受け取れるので、管理対象のキーだけを上書きし、
残りはそのまま書き戻す。

plugin 本体は .dotfiles へ vendor せず、marketplace から取得する。取得元と
commit は .claude/.plugin-lock.json に記録する。復元手順は README.manual.md を
参照する。

*/ -}}
{{- $settings := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $settings = .chezmoi.stdin | fromJson -}}
{{- end -}}

{{- /*
  marketplace の取得元。plugin を有効化するとここから clone される。
  Claude Code は marketplace 側の commit 固定に対応しない（ref はブランチとタグ
  のみ）ため、ここでは既定のブランチを追う。取得された commit は
  .claude/.plugin-lock.json に記録する。
*/ -}}
{{- $marketplaces := dict -}}
{{- if hasKey $settings "extraKnownMarketplaces" -}}
{{-   $marketplaces = index $settings "extraKnownMarketplaces" -}}
{{- end -}}
{{- $_ := set $marketplaces "openai-codex" (dict
      "source" (dict
        "source" "git"
        "url" "https://github.com/openai/codex-plugin-cc.git")) -}}
{{- $_ = set $marketplaces "dotnet-agent-skills" (dict
      "source" (dict
        "source" "git"
        "url" "https://github.com/dotnet/skills.git")) -}}
{{- $_ = set $settings "extraKnownMarketplaces" $marketplaces -}}

{{- /*
  有効・無効の状態。切り替えは UI ではなくこのテンプレートを書き換えて
  chezmoi apply する。UI で切り替えても、次の apply でここの値に戻る。
*/ -}}
{{- $enabledPlugins := dict -}}
{{- if hasKey $settings "enabledPlugins" -}}
{{-   $enabledPlugins = index $settings "enabledPlugins" -}}
{{- end -}}

{{- /*
  codex plugin は false のまま記録する。有効化すると SessionStart、SessionEnd、
  Stop のフックが動き出すため。
*/ -}}
{{- $_ = set $enabledPlugins "codex@openai-codex" false -}}

{{- /*
  dotnet plugin は skill 1 個と C# language server を追加する。フックは持たない。
  C# ファイルを開くと dnx が roslyn-language-server の prerelease を NuGet から
  取得して常駐させる。
*/ -}}
{{- $_ = set $enabledPlugins "dotnet@dotnet-agent-skills" true -}}
{{- $_ = set $settings "enabledPlugins" $enabledPlugins -}}

{{ $settings | toPrettyJson }}
