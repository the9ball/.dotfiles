{{- /* chezmoi:modify-template */ -}}
{{- /*

Of ~/.claude/settings.json, only the keys set below (such as the plugin sources
and their enabled/disabled state) are placed under .dotfiles management. Claude Code itself writes permissions
and hooks into the same file, so replacing the whole file would roll those back.
A modify_ template receives the current content via .chezmoi.stdin, so it overwrites
only the managed keys and writes everything else back unchanged.

The plugins themselves are not vendored into .dotfiles; they are fetched from the
marketplace. The source and commit are recorded in .claude/.plugin-lock.json. See
README.manual.md for the restore procedure.

*/ -}}
{{- $settings := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $settings = .chezmoi.stdin | fromJson -}}
{{- end -}}

{{- /*
  Marketplace sources. Enabling a plugin clones it from here.
  Claude Code does not support pinning a commit on the marketplace side (a ref can
  only be a branch or tag), so this follows the default branch. The commit that
  was fetched is recorded in .claude/.plugin-lock.json.
*/ -}}
{{- $marketplaces := dict -}}
{{- if hasKey $settings "extraKnownMarketplaces" -}}
{{-   $marketplaces = index $settings "extraKnownMarketplaces" -}}
{{- end -}}
{{- $_ := set $marketplaces "openai-codex" (dict
      "source" (dict
        "source" "git"
        "url" "https://github.com/openai/codex-plugin-cc.git")) -}}
{{- $_ = set $marketplaces "dotnet-agent-skills" (dict
      "source" (dict
        "source" "git"
        "url" "https://github.com/dotnet/skills.git")) -}}
{{- $_ = set $settings "extraKnownMarketplaces" $marketplaces -}}

{{- /*
  Enabled/disabled state. Switch it by editing this template and running
  chezmoi apply, not through the UI. A change made in the UI reverts to the value
  here on the next apply.
*/ -}}
{{- $enabledPlugins := dict -}}
{{- if hasKey $settings "enabledPlugins" -}}
{{-   $enabledPlugins = index $settings "enabledPlugins" -}}
{{- end -}}

{{- /*
  The codex plugin stays recorded as false, because enabling it starts the
  SessionStart, SessionEnd, and Stop hooks.
*/ -}}
{{- $_ = set $enabledPlugins "codex@openai-codex" false -}}

{{- /*
  The dotnet plugin adds one skill and a C# language server. It has no hooks.
  When a C# file is opened, dnx fetches a prerelease of roslyn-language-server from
  NuGet and keeps it resident.
*/ -}}
{{- $_ = set $enabledPlugins "dotnet@dotnet-agent-skills" true -}}
{{- $_ = set $settings "enabledPlugins" $enabledPlugins -}}

{{- /*
  Disable the prompt suggestions shown in the input box after a reply, since they are not needed.
*/ -}}
{{- $_ = set $settings "promptSuggestionEnabled" false -}}

{{- /*
  Use auto mode as the default permission mode in every project. Auto mode lets
  a safety classifier approve routine actions instead of prompting for each
  one, so more actions run without a prompt. It does not replace the approval
  rules in the shared AGENTS.md (external operations, UI automation, and so on),
  which still apply. Terminal sessions honor a project or local setting that
  pins another mode. The VS Code extension does not read project settings for
  its starting mode and checks claudeCode.initialPermissionMode and the mode
  last picked in its mode indicator before this value. Only defaultMode is managed; allow, ask, and other
  keys that Claude Code writes into permissions are written back unchanged. If
  auto mode is unavailable at startup, Claude Code falls back to the default
  mode with a notice.
*/ -}}
{{- $permissions := dict -}}
{{- if hasKey $settings "permissions" -}}
{{-   $permissions = index $settings "permissions" -}}
{{- end -}}
{{- $_ = set $permissions "defaultMode" "auto" -}}
{{- $_ = set $settings "permissions" $permissions -}}

{{- /*
  Per-Skill overrides for shared Skills in Claude Code. The Skills stay
  published at ~/.claude/skills and remain available to Codex.
  - "off" disables the Skill in Claude Code: the model does not see it and
    /name is refused. Used for Codex-only Skills, whose workflows target Codex
    threads, Codex Desktop, or the Windows Codex app.
  - "user-invocable-only" hides the Skill from the model's listing but keeps
    /name. Used for explicit-invocation Skills with no recorded use in Claude
    Code.
  Other skillOverrides entries are written back unchanged. Removing a name
  from these lists stops managing it but keeps the value already saved in
  settings.json; to restore a Skill, also delete its key there or set it to
  "on".
*/ -}}
{{- $skillOverrides := dict -}}
{{- if hasKey $settings "skillOverrides" -}}
{{-   $skillOverrides = index $settings "skillOverrides" -}}
{{- end -}}
{{- range list "delegate-readonly-investigation" "wsl-codex-exec" "task-complete-notify" -}}
{{-   $_ = set $skillOverrides . "off" -}}
{{- end -}}
{{- range list "openpoi" "unity-editor-build-log" "pink-elephant-guard" "rigorous-review" "task-continuity-cleanup" "cognitive-rhythm-writing" "japanese-tech-writing" "codex-rate-limits" "codex-project-roots" -}}
{{-   $_ = set $skillOverrides . "user-invocable-only" -}}
{{- end -}}
{{- $_ = set $settings "skillOverrides" $skillOverrides -}}

{{- /*
  Load the mods published at ~/.claude/mods (a link to link-targets/claude/mods)
  from disk. Claude Code reads CLAUDE_CODE_PLUGIN_DIRS from this env block, as
  absolute paths joined by the platform's path-list separator. The value is
  managed here, so a folder added to it by hand reverts on the next apply.
  Other env keys are written back unchanged.
*/ -}}
{{- $env := dict -}}
{{- if hasKey $settings "env" -}}
{{-   $env = index $settings "env" -}}
{{- end -}}
{{- $_ = set $env "CLAUDE_CODE_PLUGIN_DIRS" (joinPath .chezmoi.homeDir ".claude" "mods" "context") -}}
{{- $_ = set $settings "env" $env -}}

{{- $settings | toPrettyJson -}}
