{{- /* chezmoi:modify-template */ -}}
{{- /*

Of ~/.claude/settings.json, only the plugin sources and their enabled/disabled
state are placed under .dotfiles management. Claude Code itself writes permissions
and hooks into the same file, so replacing the whole file would roll those back.
A modify_ template receives the current content via .chezmoi.stdin, so it overwrites
only the managed keys and writes everything else back unchanged.

The plugins themselves are not vendored into .dotfiles; they are fetched from the
marketplace. The source and commit are recorded in .claude/.plugin-lock.json. See
README.manual.md for the restore procedure.

*/ -}}
{{- $settings := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $settings = .chezmoi.stdin | fromJson -}}
{{- end -}}

{{- /*
  Marketplace sources. Enabling a plugin clones it from here.
  Claude Code does not support pinning a commit on the marketplace side (a ref can
  only be a branch or tag), so this follows the default branch. The commit that
  was fetched is recorded in .claude/.plugin-lock.json.
*/ -}}
{{- $marketplaces := dict -}}
{{- if hasKey $settings "extraKnownMarketplaces" -}}
{{-   $marketplaces = index $settings "extraKnownMarketplaces" -}}
{{- end -}}
{{- $_ := set $marketplaces "openai-codex" (dict
      "source" (dict
        "source" "git"
        "url" "https://github.com/openai/codex-plugin-cc.git")) -}}
{{- $_ = set $marketplaces "dotnet-agent-skills" (dict
      "source" (dict
        "source" "git"
        "url" "https://github.com/dotnet/skills.git")) -}}
{{- $_ = set $settings "extraKnownMarketplaces" $marketplaces -}}

{{- /*
  Enabled/disabled state. Switch it by editing this template and running
  chezmoi apply, not through the UI. A change made in the UI reverts to the value
  here on the next apply.
*/ -}}
{{- $enabledPlugins := dict -}}
{{- if hasKey $settings "enabledPlugins" -}}
{{-   $enabledPlugins = index $settings "enabledPlugins" -}}
{{- end -}}

{{- /*
  The codex plugin stays recorded as false, because enabling it starts the
  SessionStart, SessionEnd, and Stop hooks.
*/ -}}
{{- $_ = set $enabledPlugins "codex@openai-codex" false -}}

{{- /*
  The dotnet plugin adds one skill and a C# language server. It has no hooks.
  When a C# file is opened, dnx fetches a prerelease of roslyn-language-server from
  NuGet and keeps it resident.
*/ -}}
{{- $_ = set $enabledPlugins "dotnet@dotnet-agent-skills" true -}}
{{- $_ = set $settings "enabledPlugins" $enabledPlugins -}}

{{- /*
  Disable the prompt suggestions shown in the input box after a reply, since they are not needed.
*/ -}}
{{- $_ = set $settings "promptSuggestionEnabled" false -}}

{{- $settings | toPrettyJson -}}
