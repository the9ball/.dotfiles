{{- /* chezmoi:modify-template */ -}}
{{- /*

Manage only the rootPaths of the local project containing the dotfiles root in
the Windows Codex Desktop state. Project display names are runtime-owned and
may vary between Codex versions, so the project is identified by its root
path. If the project does not exist yet, leave the state unchanged rather than
creating or rejecting it.

*/ -}}
{{- if not .chezmoi.stdin -}}
{{-   fail "the existing .codex-global-state.json is required; refusing to create it" -}}
{{- end -}}
{{- $state := fromJson .chezmoi.stdin -}}
{{- if not (kindIs "map" $state) -}}
{{-   fail "the Codex global state must be a JSON object" -}}
{{- end -}}
{{- if not (hasKey $state "local-projects") -}}
{{-   fail "the Codex global state has no local-projects object" -}}
{{- end -}}
{{- $projects := index $state "local-projects" -}}
{{- if not (kindIs "map" $projects) -}}
{{-   fail "local-projects must be a JSON object" -}}
{{- end -}}

{{- $home := .chezmoi.rawHomeDir -}}
{{- $dotfilesRoot := printf "%s\\.dotfiles" $home -}}
{{- $normalizedDotfilesRoot := lower (replace "/" "\\" $dotfilesRoot) -}}
{{- $projectKey := "" -}}
{{- $matches := 0 -}}
{{- range $key, $project := $projects -}}
  {{- if not (kindIs "map" $project) -}}
    {{- fail (printf "local project %q must be a JSON object" $key) -}}
  {{- end -}}
  {{- if not (hasKey $project "rootPaths") -}}
    {{- fail (printf "local project %q has no rootPaths array" $key) -}}
  {{- end -}}
  {{- $projectRoots := index $project "rootPaths" -}}
  {{- if not (kindIs "slice" $projectRoots) -}}
    {{- fail (printf "local project %q rootPaths must be an array" $key) -}}
  {{- end -}}
  {{- $containsDotfilesRoot := false -}}
  {{- range $root := $projectRoots -}}
    {{- if not (kindIs "string" $root) -}}
      {{- fail (printf "local project %q rootPaths array must contain only strings" $key) -}}
    {{- end -}}
    {{- if eq (lower (replace "/" "\\" $root)) $normalizedDotfilesRoot -}}
      {{- $containsDotfilesRoot = true -}}
    {{- end -}}
  {{- end -}}
  {{- if $containsDotfilesRoot -}}
    {{- $projectKey = $key -}}
    {{- $matches = add1 $matches -}}
  {{- end -}}
{{- end -}}
{{- if eq $matches 1 -}}
  {{- $project := index $projects $projectKey -}}
  {{- $existingRoots := index $project "rootPaths" -}}
  {{- $desiredRoots := list
        (printf "%s\\.agents" $home)
        (printf "%s\\.claude" $home)
        (printf "%s\\.codex" $home)
        (printf "%s\\.codex-personal" $home)
        $dotfilesRoot
  -}}
  {{- $existingRootsJSON := $existingRoots | toJson -}}
  {{- $desiredRootsJSON := $desiredRoots | toJson -}}
  {{- if eq $existingRootsJSON $desiredRootsJSON -}}
    {{- .chezmoi.stdin -}}
  {{- else -}}
    {{- $_ := set $project "rootPaths" $desiredRoots -}}
    {{- $state | toJson -}}
  {{- end -}}
{{- else if gt $matches 1 -}}
  {{- fail (printf "found %d local projects containing the dotfiles root %q" $matches $dotfilesRoot) -}}
{{- else -}}
  {{- .chezmoi.stdin -}}
{{- end -}}
