# Copy this file to ~/.gitconfig.local and edit it for this machine.
#
# Keep user.name and user.email in one file per identity under
# ~/.dotfiles/git_user/. Keep the scopes of different identities from
# overlapping. Do not add a direct [user] name/email here.
#
# Rules for non-overlapping trees that contain multiple repositories.
# A trailing slash matches everything below that directory, including
# the gitdirs of all repositories and their linked worktrees in the tree.
#
# [includeIf "gitdir:~/path/to/public-repositories/"]
# 	path = ~/.dotfiles/git_user/shaula.gitconfig
#
# [includeIf "gitdir:~/path/to/work-repositories/"]
# 	path = ~/.dotfiles/git_user/shoichi-yasui.gitconfig
#
# Rules for a single repository registered on its own. For linked
# worktrees that need the same identity, add both rules with the same
# profile. A rule ending in .git/ misses .git itself. A rule for the
# repository root ending in / also matches independent repositories
# nested below that root.
#
# [includeIf "gitdir:~/path/to/repositories/example/.git"]
# 	path = ~/.dotfiles/git_user/shaula.gitconfig
#
# [includeIf "gitdir:~/path/to/repositories/example/.git/worktrees/"]
# 	path = ~/.dotfiles/git_user/shaula.gitconfig
