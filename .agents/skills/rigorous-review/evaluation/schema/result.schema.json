{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the9ball/.dotfiles/rigorous-review-evaluation/result.schema.json",
  "title": "Issue #6 paired evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "side",
    "case_id",
    "fixture_manifest_sha256",
    "target_manifest_hash",
    "epoch_hash",
    "role_context",
    "model_identity",
    "routing_status",
    "deterministic_checks",
    "evidence_status",
    "coverage_status",
    "gate_status",
    "proceed_status",
    "escalation_step",
    "escalation_trace",
    "finding_count",
    "propositions",
    "packet_sha256",
    "dispatch_receipt_sha256",
    "input_tokens",
    "output_tokens",
    "dispatch_count",
    "runtime_dispatch_attempted",
    "runtime_dispatch_enforcement_claimed"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "side": { "enum": ["baseline", "candidate"] },
    "case_id": { "type": "string" },
    "fixture_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "target_manifest_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "epoch_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "role_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_context_id", "respondent_context_id", "contexts_distinct", "joint_record_version", "reviewer_approved", "respondent_approved"],
      "properties": {
        "reviewer_context_id": { "type": "string", "minLength": 1 },
        "respondent_context_id": { "type": "string", "minLength": 1 },
        "contexts_distinct": { "const": true },
        "joint_record_version": { "type": "string", "minLength": 1 },
        "reviewer_approved": { "type": "boolean" },
        "respondent_approved": { "type": "boolean" }
      }
    },
    "model_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "respondent"],
      "properties": {
        "reviewer": { "type": "string", "minLength": 1 },
        "respondent": { "type": "string", "minLength": 1 }
      }
    },
    "routing_status": { "const": "DECLARED_ONLY" },
    "deterministic_checks": { "enum": ["PASS", "BLOCKED"] },
    "evidence_status": { "enum": ["SUFFICIENT", "NEEDS_EVIDENCE", "INVALID", "MISSING"] },
    "coverage_status": { "enum": ["RELIABLE", "UNRELIABLE", "MISSING"] },
    "gate_status": { "enum": ["PASS", "BLOCKED"] },
    "proceed_status": { "const": "NOT_AUTHORIZED" },
    "escalation_step": { "enum": ["none", "eligibility", "reviewer", "respondent", "evidence_reacquisition", "neutral_adviser"] },
    "escalation_trace": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["none", "eligibility", "reviewer", "respondent", "evidence_reacquisition", "neutral_adviser"] }
    },
    "finding_count": { "type": "integer", "minimum": 0 },
    "propositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposition_id", "severity", "discovery", "rejection"],
        "properties": {
          "proposition_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "discovery": { "enum": ["FOUND", "MISSED", "NOT_APPLICABLE"] },
          "rejection": { "enum": ["REJECTED", "RETAINED", "NOT_APPLICABLE"] }
        }
      }
    },
    "packet_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dispatch_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "joint_record_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "dispatch_count": { "type": "integer", "minimum": 0 },
    "runtime_dispatch_attempted": { "const": false },
    "runtime_dispatch_enforcement_claimed": { "const": false }
  }
}
