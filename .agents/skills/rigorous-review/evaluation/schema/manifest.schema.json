{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the9ball/.dotfiles/rigorous-review-evaluation/manifest.schema.json",
  "title": "Issue #6 fixture evaluation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_id",
    "harness_mode",
    "default_path_changed",
    "runtime_dispatch_attempted",
    "runtime_dispatch_enforcement_claimed",
    "target",
    "epoch_hash",
    "quality_policy",
    "cases"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "manifest_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "harness_mode": { "const": "fixture_only_observe_only" },
    "default_path_changed": { "const": false },
    "runtime_dispatch_attempted": { "const": false },
    "runtime_dispatch_enforcement_claimed": { "const": false },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "identity_hash", "files"],
      "properties": {
        "repository": { "const": "the9ball/.dotfiles" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "identity_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "line_count"],
            "properties": {
              "path": { "type": "string", "pattern": "^[^/].*[^/]$" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "line_count": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "epoch_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "quality_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_structural_metrics", "exact_discovery_severities", "informational_severities", "informational_metrics", "invalid_input_status"],
      "properties": {
        "exact_structural_metrics": {
          "const": ["gate", "evidence", "coverage", "deterministic_checks", "proceed"]
        },
        "exact_discovery_severities": { "const": ["high", "critical"] },
        "informational_severities": { "const": ["medium", "low"] },
        "informational_metrics": { "const": ["discovery", "rejection"] },
        "invalid_input_status": { "const": "BLOCKED" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "path", "expected_status"],
        "properties": {
          "case_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "path": { "type": "string", "pattern": "^cases/[a-z0-9][a-z0-9-]+\\.json$" },
          "expected_status": { "enum": ["PASS", "BLOCKED"] }
        }
      }
    }
  }
}
