{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the9ball/.dotfiles/rigorous-review-evaluation/joint-record.schema.json",
  "title": "Issue #6 zero-findings joint final record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "case_id",
    "side",
    "run_id",
    "fixture_manifest_sha256",
    "target_manifest_hash",
    "epoch_hash",
    "version",
    "finding_count",
    "findings",
    "evidence_status",
    "coverage_status",
    "gate_status",
    "reviewer",
    "respondent"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "record_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "case_id": { "const": "zero-findings" },
    "side": { "enum": ["baseline", "candidate"] },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "fixture_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "target_manifest_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "epoch_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "version": { "type": "string", "minLength": 1 },
    "finding_count": { "const": 0 },
    "findings": { "const": [] },
    "evidence_status": { "const": "SUFFICIENT" },
    "coverage_status": { "const": "RELIABLE" },
    "gate_status": { "const": "PASS" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "position", "approved"],
      "properties": {
        "context_id": { "type": "string", "minLength": 1 },
        "position": { "const": "NO_FINDINGS" },
        "approved": { "const": true }
      }
    },
    "respondent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "position", "approved"],
      "properties": {
        "context_id": { "type": "string", "minLength": 1 },
        "position": { "const": "NO_FINDINGS" },
        "approved": { "const": true }
      }
    }
  }
}
