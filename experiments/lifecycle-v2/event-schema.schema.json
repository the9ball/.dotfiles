{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lifecycle-v2:proposed-event-schema",
  "title": "Lifecycle v2 event proposal",
  "$comment": "Design only. No runtime implementation. See persistence-contract.md for authentication, transactions, FK, canonical hash, counters and role guards not expressible here. Parse duplicate keys and invalid Unicode before schema validation. ReceiptRejected retains malformed originals as BLOB; strict review_result does not erase unclassified debt. Format assertion must be enabled. A schema-valid PassAssessed grants no authority.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "gate_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "command_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "transaction_ordinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "writer_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "previous_event_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "clock": {
      "$ref": "#/$defs/clock"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "OWNER",
            "BROKER",
            "COLLECTOR",
            "EXECUTOR",
            "REVIEWER"
          ]
        },
        "principal_ref": {
          "type": "string",
          "minLength": 1
        },
        "proof": {
          "$ref": "#/$defs/artifact"
        }
      },
      "required": [
        "role",
        "principal_ref",
        "proof"
      ]
    },
    "event_type": {
      "enum": [
        "GateOpened",
        "ApprovalRecorded",
        "OwnershipTransferred",
        "InitialAttemptAdmitted",
        "RepairAdmitted",
        "CandidateRecorded",
        "VerificationIntentRecorded",
        "ReviewRoundAdmitted",
        "ReviewIntentRecorded",
        "LaunchStarted",
        "LaunchOutcomeRecorded",
        "JobExitObserved",
        "ReceiptStored",
        "ReceiptApplied",
        "ReceiptRejected",
        "FindingClassified",
        "FixProposed",
        "ClosureAccepted",
        "RepairFailureCharged",
        "StopLatched",
        "StopResolved",
        "ClockExpired",
        "JobRetirementAccepted",
        "PassAssessed"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "gate_id",
    "command_id",
    "sequence",
    "transaction_id",
    "transaction_ordinal",
    "writer_generation",
    "previous_event_sha256",
    "event_sha256",
    "revision",
    "clock",
    "actor",
    "event_type",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "GateOpened"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "owner_proof": {
                "$ref": "#/$defs/artifact"
              },
              "scope_manifest": {
                "$ref": "#/$defs/artifact"
              },
              "review_contract": {
                "$ref": "#/$defs/artifact"
              }
            },
            "required": [
              "owner_proof",
              "scope_manifest",
              "review_contract"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ApprovalRecorded"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "interval_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "owner_proof": {
                "$ref": "#/$defs/artifact"
              },
              "boot_id": {
                "type": "string",
                "minLength": 1
              },
              "deadline_uptime_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cumulative_caps": {
                "$ref": "#/$defs/budget"
              },
              "external_grants": {
                "$ref": "#/$defs/artifact"
              }
            },
            "required": [
              "interval_id",
              "owner_proof",
              "boot_id",
              "deadline_uptime_ms",
              "cumulative_caps",
              "external_grants"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "OwnershipTransferred"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "previous_generation": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "new_generation": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "termination_proof": {
                "$ref": "#/$defs/artifact"
              }
            },
            "required": [
              "previous_generation",
              "new_generation",
              "termination_proof"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "InitialAttemptAdmitted"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "attempt_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "interval_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "scope": {
                "$ref": "#/$defs/artifact"
              }
            },
            "required": [
              "attempt_id",
              "interval_id",
              "scope"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "RepairAdmitted"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "attempt_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "interval_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "issue_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/uuid"
                },
                "uniqueItems": true
              },
              "scope": {
                "$ref": "#/$defs/artifact"
              },
              "repair_spent_after": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "attempt_id",
              "interval_id",
              "issue_ids",
              "scope",
              "repair_spent_after"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "CandidateRecorded"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "attempt_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "snapshot": {
                "$ref": "#/$defs/artifact"
              },
              "phase": {
                "const": "SEALED"
              }
            },
            "required": [
              "attempt_id",
              "snapshot",
              "phase"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "VerificationIntentRecorded"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "attempt_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "request_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "job_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "oracle_manifest": {
                "$ref": "#/$defs/artifact"
              },
              "invocation_manifest": {
                "$ref": "#/$defs/artifact"
              }
            },
            "required": [
              "attempt_id",
              "request_id",
              "job_id",
              "oracle_manifest",
              "invocation_manifest"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ReviewRoundAdmitted"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "round_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "attempt_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "review_spent_after": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "slots": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "role_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "request_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    },
                    "job_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    },
                    "independence_proof": {
                      "$ref": "#/$defs/artifact"
                    }
                  },
                  "required": [
                    "role_id",
                    "request_id",
                    "job_id",
                    "independence_proof"
                  ]
                }
              }
            },
            "required": [
              "round_id",
              "attempt_id",
              "review_spent_after",
              "slots"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ReviewIntentRecorded"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "round_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "request_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "job_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "role_id": {
                "type": "string",
                "minLength": 1
              },
              "input": {
                "$ref": "#/$defs/artifact"
              },
              "external_grant_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            },
            "required": [
              "round_id",
              "request_id",
              "job_id",
              "role_id",
              "input",
              "external_grant_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "LaunchStarted"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "request_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "job_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "nonce": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "admission_proof": {
                "$ref": "#/$defs/artifact"
              }
            },
            "required": [
              "request_id",
              "job_id",
              "nonce",
              "admission_proof"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "LaunchOutcomeRecorded"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "job_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "outcome": {
                "enum": [
                  "STARTED",
