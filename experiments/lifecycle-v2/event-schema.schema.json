                        ]
                      },
                      "check_ids": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uniqueItems": true
                      },
                      "evidence": {
                        "$ref": "#/$defs/artifact"
                      }
                    },
                    "required": [
                      "kind",
                      "request_id",
                      "revision",
                      "outcome",
                      "check_ids",
                      "evidence"
                    ]
                  }
                ]
              },
              "effect_event_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/uuid"
