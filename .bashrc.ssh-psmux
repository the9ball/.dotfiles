# Use the personal overlay in every native Windows psmux shell, including children.
case "${OSTYPE-}" in
	msys*|cygwin*) ;;
	*) return 0 ;;
esac

# Session metadata and psmux socket paths are context markers, not trust proofs.
case "${PSMUX_SESSION-}:${TMUX-}" in
	?*:*|:/tmp/psmux-*,*)
		if [ ! -r "$HOME/.bashrc.ssh" ]; then
			printf '%s\n' 'Personal setup incomplete: apply ~/.bashrc.ssh.' >&2
			return 0
		fi
		. "$HOME/.bashrc.ssh"
		return 0
		;;
esac

# Automatic attachment is limited to direct interactive SSH terminals.
case "$-" in
	*i*) ;;
	*) return 0 ;;
esac
if [ ! -t 0 ] || [ ! -t 1 ] || [ -n "${BASH_EXECUTION_STRING-}" ]; then
	return 0
fi

if [ -z "${SSH_CONNECTION-}" ] || [ "${SHLVL-}" != 1 ] || [ -n "${TMUX-}" ]; then
	return 0
fi

# Reload after host overrides so resourcing startup files restores personal values.
if [ ! -r "$HOME/.bashrc.ssh" ]; then
	printf '%s\n' 'SSH setup incomplete: apply ~/.bashrc.ssh before auto-attaching.' >&2
	return 0
fi
. "$HOME/.bashrc.ssh"

# Bypassing attachment still keeps the direct SSH shell in its personal home.
if [ -n "${TMUX-}" ] || [ -n "${PSMUX_SESSION-}" ] ||
	[ "${PSMUX_SSH_AUTOATTACH-}" = 0 ] ||
	[ -e "$HOME/.psmux-no-autoattach" ] ||
	[ -n "${__dotfiles_psmux_autoattach_attempted-}" ]; then
	return 0
fi

# Keep this flag shell-local so sourcing the startup files again cannot attach twice.
__dotfiles_psmux_autoattach_attempted=1
if ! command -v psmux >/dev/null 2>&1; then
	printf '%s\n' 'psmux auto-attach skipped: psmux is not on PATH.' >&2
	return 0
fi

# Retain the shell after detach or failure; the psmux server owns the session.
if ! command psmux -L dotfiles-ssh new-session -A -s ssh; then
	printf '%s\n' 'psmux auto-attach failed; continuing in Git Bash.' >&2
fi
