<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>docker-credential-ssh-tpm</AssemblyName>
    <Version>0.5.0</Version>
    <RollForward>LatestPatch</RollForward>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <Target Name="RejectProductionFaultHooks" BeforeTargets="CoreCompile" Condition="$([System.String]::Copy('$(DefineConstants)').Contains('CREDENTIAL_HELPER_TEST_HOOKS'))">
    <Error Text="Fault injection is permitted only in the separate test harness." />
  </Target>
</Project>
